# ===================================================
# SkyCast Monorepo Root Environment Configuration
# Copy this file to .env in respective app folders or configure per service.
# ===================================================

# Backend API Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/skycast?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/skycast
MONGODB_URI=mongodb://127.0.0.1:27017/skycast

# JWT Secret for User Authentication
JWT_SECRET=skycast_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Open-Meteo Endpoints (Free, no API key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Web Frontend Config (Vite)
VITE_API_URL=http://localhost:5000/api/v1

# Mobile App Config (Expo)
# Use your computer's local IP (e.g. http://192.168.1.100:5000/api/v1) for testing on physical Android devices!
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
